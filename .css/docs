/* Styles for the demo page only. The kit itself is css/nojs-ui.css. */
:root {
  --page: light-dark(#eceff6, #0e1017);
  --paper: light-dark(#ffffff, #151824);
  --dots: light-dark(#c9cfe2, #272d44);
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--page);
  color: var(--nj-fg);
  font: 1rem/1.65 system-ui, -apple-system, "Segoe UI", sans-serif;
}
a { color: var(--nj-accent); }
code { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 0.9em; }

.shell {
  display: grid;
  grid-template-columns: 13rem minmax(0, 1fr);
  gap: 3.5rem;
  max-inline-size: 70rem;
  margin-inline: auto;
  padding-inline: 1.5rem;
}
.index {
  position: sticky;
  top: 0;
  align-self: start;
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  padding-block: 2.5rem;
}
.index .brand {
  margin-block-end: 1rem;
  color: var(--nj-fg);
  font-size: 1.2rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  text-decoration: none;
}
.index a:not(.brand) {
  padding: 0.3rem 0.6rem;
  margin-inline-start: -0.6rem;
  border-radius: 6px;
  color: var(--nj-fg-soft);
  font-weight: 500;
  text-decoration: none;
}
.index a:not(.brand):hover { background: var(--nj-bg-soft); color: var(--nj-fg); }

main { max-inline-size: 46rem; padding-block: 3.5rem 5rem; }
h1 {
  max-inline-size: 13ch;
  margin: 0 0 1.1rem;
  font-size: clamp(2.5rem, 7vw, 4.4rem);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.05em;
}
.lede { max-inline-size: 38rem; margin: 0 0 1.5rem; color: var(--nj-fg-soft); font-size: 1.15rem; }
.try { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-block: 1.5rem 2rem; }

section { padding-block: 3rem 1rem; border-block-start: 1px solid var(--nj-line); scroll-margin-top: 0.5rem; }
h2 { margin: 0 0 0.4rem; font-size: 1.6rem; letter-spacing: -0.03em; }
section > p { max-inline-size: 38rem; margin: 0; color: var(--nj-fg-soft); }

.stage {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
  min-block-size: 8rem;
  margin-block: 1.4rem 0.9rem;
  padding: 2rem;
  border: 1px solid var(--nj-line);
  border-radius: 14px;
  background-color: var(--paper);
  background-image: radial-gradient(var(--dots) 1px, transparent 1px);
  background-size: 16px 16px;
}
.stage.block { display: block; }

pre {
  margin: 0 0 1rem;
  padding: 1rem 1.15rem;
  overflow-x: auto;
  border-radius: 10px;
  background: #12141f;
  color: #e6e9f5;
  font-size: 0.84rem;
  line-height: 1.6;
}
pre.snippet { margin-block: 0 1.5rem; }

table { inline-size: 100%; margin-block: 1.2rem; border-collapse: collapse; font-size: 0.95rem; }
th, td { padding: 0.65rem 0.8rem; border-block-end: 1px solid var(--nj-line); text-align: start; vertical-align: top; }
th { font-weight: 700; }
td:first-child { font-weight: 600; white-space: nowrap; }

footer { padding-block: 2rem 4rem; color: var(--nj-fg-soft); font-size: 0.95rem; }

@media (max-width: 52rem) {
  .shell { grid-template-columns: 1fr; gap: 0; }
  .index { position: static; flex-direction: row; flex-wrap: wrap; gap: 0.25rem 0.5rem; padding-block: 1.25rem 0; }
  .index .brand { inline-size: 100%; margin-block-end: 0.25rem; }
  .index a:not(.brand) { margin-inline-start: 0; }
  main { padding-block-start: 2rem; }
  .stage { padding: 1.25rem; }
}

/*!
 * nojs-ui v0.1.0 - interactive UI components with zero JavaScript.
 * Built on: Popover API, <dialog>, <details name>, :has(), CSS anchor
 * positioning, @starting-style, light-dark(). MIT licensed.
 */
@layer nj.tokens, nj.components;

/* ---------- Tokens: override these in your own CSS ---------- */
@layer nj.tokens {
  :root {
    color-scheme: light dark;
    interpolate-size: allow-keywords;

    --nj-accent: oklch(55% 0.2 265);
    --nj-accent-fg: #fff;
    --nj-danger: oklch(56% 0.21 25);

    --nj-bg: light-dark(#ffffff, #171923);
    --nj-bg-soft: light-dark(#f1f3f9, #202434);
    --nj-fg: light-dark(#161a2e, #e8eaf3);
    --nj-fg-soft: light-dark(#5a607a, #9aa0b8);
    --nj-line: light-dark(#d6dae7, #343950);

    --nj-radius: 10px;
    --nj-shadow: 0 14px 34px -10px rgb(15 20 50 / 0.35);
    --nj-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    --nj-dur: 0.22s;
  }
}

@layer nj.components {
  /* ---------- Button ---------- */
  .nj-btn {
    font: inherit;
    font-weight: 600;
    padding: 0.55em 1.05em;
    border: 1px solid var(--nj-line);
    border-radius: var(--nj-radius);
    background: var(--nj-bg);
    color: var(--nj-fg);
    cursor: pointer;
    transition: background var(--nj-dur) var(--nj-ease);
  }
  .nj-btn:hover { background: var(--nj-bg-soft); }
  .nj-btn:focus-visible,
  .nj-menu :is(a, button):focus-visible,
  .nj-tabs > label:has(input:focus-visible),
  .nj-accordion summary:focus-visible {
    outline: 2px solid var(--nj-accent);
    outline-offset: 2px;
  }
  .nj-btn--primary {
    background: var(--nj-accent);
    border-color: transparent;
    color: var(--nj-accent-fg);
  }
  .nj-btn--primary:hover {
    background: color-mix(in oklch, var(--nj-accent) 86%, black);
  }
  .nj-btn--danger {
    background: var(--nj-danger);
    border-color: transparent;
    color: #fff;
  }
  .nj-btn--danger:hover {
    background: color-mix(in oklch, var(--nj-danger) 86%, black);
  }
  .nj-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.6rem;
    margin-block-start: 1.5rem;
  }

  /* ---------- Shared popover surface + enter/exit animation ---------- */
  :is(.nj-modal, .nj-drawer, .nj-menu) {
    color: var(--nj-fg);
    background: var(--nj-bg);
    border: 1px solid var(--nj-line);
    box-shadow: var(--nj-shadow);
    opacity: 0;
    transition:
      opacity var(--nj-dur) var(--nj-ease),
      translate var(--nj-dur) var(--nj-ease),
      scale var(--nj-dur) var(--nj-ease),
      overlay var(--nj-dur) allow-discrete,
      display var(--nj-dur) allow-discrete;
  }
  :is(.nj-modal, .nj-drawer, .nj-menu):popover-open { opacity: 1; }
  :is(.nj-modal, .nj-drawer)::backdrop {
    background: rgb(10 12 30 / 0.5);
    opacity: 0;
    transition:
      opacity var(--nj-dur) var(--nj-ease),
      overlay var(--nj-dur) allow-discrete,
      display var(--nj-dur) allow-discrete;
  }
  :is(.nj-modal, .nj-drawer):popover-open::backdrop { opacity: 1; }

  /* ---------- Modal: <dialog class="nj-modal" popover> ---------- */
  .nj-modal {
    inline-size: min(30rem, calc(100vw - 2rem));
    padding: 1.5rem;
    border-radius: calc(var(--nj-radius) * 1.6);
    translate: 0 0.75rem;
    scale: 0.98;
  }
  .nj-modal:popover-open { translate: 0 0; scale: 1; }
  .nj-modal :is(h2, h3) { margin: 0 0 0.5rem; letter-spacing: -0.02em; }
  .nj-modal p { margin: 0; color: var(--nj-fg-soft); }

  /* ---------- Drawer: <div class="nj-drawer" popover> ---------- */
  .nj-drawer {
    inset: 0 0 0 auto;
    margin: 0;
    block-size: 100dvh;
    max-block-size: none;
    inline-size: min(24rem, 100vw);
    padding: 1.5rem;
    border-width: 0;
    border-inline-start-width: 1px;
    translate: 100% 0;
  }
  .nj-drawer:popover-open { translate: 0 0; }
  .nj-drawer h2, .nj-drawer h3 { margin: 0 0 1rem; letter-spacing: -0.02em; }
  .nj-drawer label { display: flex; gap: 0.6rem; padding-block: 0.35rem; }

  /* ---------- Dropdown menu: popover + CSS anchor positioning ---------- */
  .nj-menu {
    margin: 0;
    padding: 0.35rem;
    min-inline-size: 12rem;
    border-radius: calc(var(--nj-radius) * 1.2);
    translate: 0 -0.25rem;
  }
  .nj-menu:popover-open { translate: 0 0; }
  @supports (position-area: block-end) {
    .nj-menu {
      inset: auto;
      position-area: block-end span-inline-end;
      margin-block-start: 0.35rem;
      position-try-fallbacks: flip-block, flip-inline;
    }
  }
  .nj-menu :is(a, button) {
    display: block;
    inline-size: 100%;
    padding: 0.5rem 0.7rem;
    border: 0;
    border-radius: calc(var(--nj-radius) - 3px);
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }
  .nj-menu :is(a, button):is(:hover, :focus-visible) { background: var(--nj-bg-soft); }

  /* ---------- Tooltip: <button data-tip="Text"> ---------- */
  [data-tip] { position: relative; }
  [data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    inset-block-end: calc(100% + 0.5rem);
    inset-inline-start: 50%;
    translate: -50% 0.25rem;
    z-index: 10;
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    background: var(--nj-fg);
    color: var(--nj-bg);
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--nj-dur) var(--nj-ease), translate var(--nj-dur) var(--nj-ease);
  }
  [data-tip]:is(:hover, :focus-visible)::after { opacity: 1; translate: -50% 0; }

  /* ---------- Tabs: radios + :has(), no ids needed ----------
     <div class="nj-tabs">
       <label><input type="radio" name="x" checked> One</label>
       <div class="nj-panel">...</div>
       <label><input type="radio" name="x"> Two</label>
       <div class="nj-panel">...</div>
     </div> */
  .nj-tabs { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .nj-tabs > label {
    padding: 0.5rem 0.95rem;
    border-radius: var(--nj-radius);
    color: var(--nj-fg-soft);
    font-weight: 600;
    cursor: pointer;
  }
  .nj-tabs > label:hover { color: var(--nj-fg); }
  .nj-tabs > label:has(input:checked) {
    background: var(--nj-bg-soft);
    color: var(--nj-fg);
    box-shadow: inset 0 -2px 0 var(--nj-accent);
  }
  .nj-tabs > label > input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .nj-tabs > .nj-panel { display: none; order: 1; flex: 0 0 100%; padding-block: 1rem 0.25rem; }
  .nj-tabs > label:has(input:checked) + .nj-panel { display: block; }

  /* ---------- Accordion: <details name="group"> ---------- */
  .nj-accordion {
    border: 1px solid var(--nj-line);
    border-radius: calc(var(--nj-radius) * 1.2);
    background: var(--nj-bg);
    overflow: clip;
  }
  .nj-accordion details + details { border-block-start: 1px solid var(--nj-line); }
  .nj-accordion summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.1rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  .nj-accordion summary::-webkit-details-marker { display: none; }
  .nj-accordion summary::after {
    content: "";
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    rotate: 45deg;
    translate: 0 -0.15rem;
    transition: rotate var(--nj-dur) var(--nj-ease);
  }
  .nj-accordion details[open] > summary::after { rotate: -135deg; translate: 0 0.1rem; }
  .nj-accordion details > :not(summary) { margin: 0; padding: 0 1.1rem 1rem; color: var(--nj-fg-soft); }
  @supports selector(::details-content) {
    .nj-accordion details::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size var(--nj-dur) var(--nj-ease),
        content-visibility var(--nj-dur) allow-discrete;
    }
    .nj-accordion details[open]::details-content { block-size: auto; }
  }

  /* ---------- Respect reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    :is(.nj-btn, .nj-modal, .nj-drawer, .nj-menu, [data-tip]::after, .nj-accordion *),
    :is(.nj-modal, .nj-drawer)::backdrop,
    .nj-accordion details::details-content {
      transition-duration: 0.01ms !important;
    }
  }
}
